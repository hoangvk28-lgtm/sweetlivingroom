# Canonical site URL. Used for canonicals, sitemap, robots and schema.
# Must be set in the Cloudflare Pages project, or every absolute URL in the
# build falls back to the default in lib/brand.ts.
NEXT_PUBLIC_SITE_URL=https://www.sweetlivingroom.com

# GA4 measurement id. Leave unset and no analytics script is emitted.
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity project id. Optional override: the site falls back to
# CLARITY_PROJECT_ID in lib/brand.ts when this is unset.
NEXT_PUBLIC_CLARITY_ID=
